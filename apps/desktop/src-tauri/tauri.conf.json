{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "acta",
  "version": "0.1.3",
  "identifier": "com.edunavajas.acta",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "acta",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 20,
          "y": 24
        },
        "windowEffects": {
          "effects": [
            "liquidGlassRegular",
            "sidebar"
          ],
          "state": "followsWindowActiveState"
        }
      },
      {
        "label": "overlay",
        "title": "acta",
        "url": "overlay.html",
        "width": 280,
        "height": 56,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visible": false,
        "acceptFirstMouse": true,
        "windowEffects": {
          "effects": [
            "liquidGlassRegular",
            "hudWindow"
          ],
          "state": "active",
          "radius": 28,
          "color": "#101014b3"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/Library/Application Support/acta/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": null,
      "hardenedRuntime": false,
      "minimumSystemVersion": "14.2"
    }
  }
}
